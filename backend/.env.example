# sentence-transformers (Auto Layout classification)
ENMESH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Mesh generator — use cpu on machines without a GPU (Dockerfile is CPU-only).
ENMESH_DEVICE=cpu
ENMESH_MODEL_ID=stabilityai/TripoSR
ENMESH_CHUNK_SIZE=4096
ENMESH_RESOLUTION=128

# 0 = keep TripoSR scale (better for relative real-world-ish sizing across assets).
# >0 = force every mesh's longest AABB edge to this (uniform prop size, not relative).
ENMESH_MESH_NORMALIZE_MAX_EXTENT=0
# Move centroid to origin (pivot); still applied when max extent is 0 (scale only skipped).
ENMESH_MESH_NORMALIZE_CENTER=true

# Match TripoSR Gradio export: mesh faces the conditioning image (recommended).
ENMESH_ALIGN_TRIPOSR_VIEW=true
# Rotate JPEG/TIFF pixels to match on-screen orientation before inference.
ENMESH_APPLY_EXIF_ORIENTATION=true
# Default uniform multiplier when ?scale= is omitted (see /generate).
ENMESH_DEFAULT_MESH_SCALE=1.0
