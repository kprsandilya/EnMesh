# EnMesh backend configuration (all optional — sensible defaults are built in)

# PyTorch device.  "cpu" is the default (no GPU required).
ENMESH_DEVICE=cpu

# HuggingFace model identifier for TripoSR
ENMESH_MODEL_ID=stabilityai/TripoSR

# Renderer chunk size (lower = less RAM usage, slower)
ENMESH_CHUNK_SIZE=4096

# Default marching-cubes resolution (64–512; lower = faster on CPU)
ENMESH_RESOLUTION=128
