# EnMesh backend configuration (all optional — sensible defaults are built in)

# PyTorch device.  Use "cpu" if no NVIDIA GPU is available.
ENMESH_DEVICE=cuda:0

# HuggingFace model identifier for TripoSR
ENMESH_MODEL_ID=stabilityai/TripoSR

# Renderer chunk size (lower = less VRAM, slower)
ENMESH_CHUNK_SIZE=8192

# Default marching-cubes resolution (64–512)
ENMESH_RESOLUTION=256
